# ---------- App ----------
APP_ENV=development
SECRET_KEY=change-me-generate-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173

# ---------- Database ----------
# SQLite (default, zero setup):
DATABASE_URL=sqlite:///./data/app.db
# MySQL (recommended for the full demo):
# DATABASE_URL=mysql+pymysql://app_user:password@localhost:3306/ai_copilot
# Optional separate READ-ONLY connection used by the SQL agent.
# For SQLite the agent opens the same file in read-only mode automatically.
# READONLY_DATABASE_URL=mysql+pymysql://readonly_user:password@localhost:3306/ai_copilot

# ---------- Initial admin (used by scripts/create_admin.py) ----------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# ---------- LLM provider: ollama | openai_compatible | none ----------
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434
# For a hosted OpenAI-compatible API:
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
LLM_TIMEOUT_SECONDS=120

# ---------- RAG ----------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=8
RRF_K=60

# ---------- Optional integrations ----------
TAVILY_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-business-copilot
